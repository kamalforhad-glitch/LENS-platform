# LENS Website Environment Variables
# Copy this to .env.local and fill in your values.
# Variable NAMES only — never commit real secrets.
#
# SCOPES:
# - LOCAL DEV: DATABASE_URL + DIRECT_URL both point at local Postgres.
#   R2_MEDIA_* and R2_BACKUP_* are unset locally — uploads fall back to
#   public/uploads/ (ephemeral) and backups stay local-only.
# - VERCEL PREVIEW/PRODUCTION runtime: DATABASE_URL = Supabase pooler
#   (port 6543 + ?pgbouncer=true&connection_limit=1); DIRECT_URL is NOT
#   used at runtime but IS required for `prisma migrate deploy`, pg_dump
#   and psql (port 5432).
# - MIGRATION/ADMIN: run with both DATABASE_URL (pooler ok for status checks)
#   and DIRECT_URL (direct) set; migrations execute over DIRECT_URL.
# - NEXT_PUBLIC_* is browser-visible. Never put DATABASE_URL, DIRECT_URL,
#   JWT_SECRET, service-role keys, R2 secrets, encryption keys or admin
#   passwords there.
# - R2_MEDIA_* and R2_BACKUP_* must be different buckets in production.

# ============================================================
# SITE CONFIGURATION
# ============================================================
# Canonical production URL. Must match the production domain
# (metadataBase, canonical, OG/Twitter, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://www.lensbd.org

# ============================================================
# ANALYTICS
# ============================================================
# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# ============================================================
# SEARCH CONSOLE VERIFICATION
# ============================================================
# Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

# Bing Webmaster Tools
NEXT_PUBLIC_BING_VERIFICATION=your-bing-verification-code

# ============================================================
# SERVER-SIDE (Never expose to client)
# ============================================================
# Authentication (min 32 chars, fail-closed if missing)
JWT_SECRET=change-this-to-a-strong-random-secret-min-32-chars-in-production

# Cron protection for /api/cron/backup (required — endpoint returns 503 if unset).
# NOTE: scheduled backups run from the GitHub Actions "Scheduled database
# backup" workflow (pg_dump needs a runtime with PostgreSQL client tools, which
# serverless Vercel does not provide). CRON_SECRET guards the MANUAL
# admin-trigger backup endpoint only.
CRON_SECRET=change-this-to-a-strong-random-cron-secret

# Initial admin seeding (required to create first admin; never commit a real value)
# SEMANTICS: this is ONLY an input to `npx tsx prisma/seed.ts` — it is skipped
# entirely when admin@lens.org.bd already exists and NEVER resets an existing
# password. See DEPLOYMENT_RUNBOOK.md § Administrator bootstrap.
ADMIN_SEED_PASSWORD=change-this-to-a-strong-random-password

# Self-hosting / Render multi-instance ONLY (not used on Vercel):
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<strong-random-key, same value on all instances>
# Required so Server Function encryption is identical across every instance of
# the same service; a mismatch produces "Failed to find Server Action".

# ============================================================
# DATABASE (PostgreSQL + pgvector + pg_trgm — Supabase)
# ============================================================
# Vercel runtime (serverless): use the Supabase TRANSACTION POOLER
# (port 6543) with pgbouncer mode so serverless functions share
# a small pool. Example shape only — never commit a real value:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://user:password@localhost:5432/lens_db?schema=public
#
# Migrations / backups / admin (DIRECT_URL): use the Supabase DIRECT
# connection (port 5432, no pgbouncer). prisma migrate deploy, pg_dump
# and psql must use DIRECT_URL. For non-pooler local dev you may set
# DIRECT_URL to the same value as DATABASE_URL.
# DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/lens_db?schema=public

# ============================================================
# MEDIA STORAGE (Cloudflare R2 — S3-compatible API)
# ============================================================
# Media uploads use only R2_MEDIA_BUCKET. Never share with backups.
# Production media bucket: lens-media
# R2_MEDIA_BUCKET=lens-media
# R2_MEDIA_REGION=auto
# R2_MEDIA_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_MEDIA_ACCESS_KEY_ID=your-r2-access-key-id
# R2_MEDIA_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Public URL for media objects (CDN or R2 public bucket URL).
# R2_MEDIA_PUBLIC_URL=https://cdn.lensbd.org

# ============================================================
# BACKUP ARTIFACT PERSISTENCE (Cloudflare R2 — NOT AWS)
# ============================================================
# Database backups use only R2_BACKUP_BUCKET. Never share with media.
# Production backup bucket: lens-backups
# Backup objects must NOT have public URLs — do not set R2_BACKUP_PUBLIC_URL.
# R2_BACKUP_BUCKET=lens-backups
# R2_BACKUP_REGION=auto
# R2_BACKUP_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_BACKUP_ACCESS_KEY_ID=your-r2-access-key-id
# R2_BACKUP_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Backup encryption (required in production).
# Generate: openssl rand -base64 32
# Must decode to exactly 32 bytes (AES-256-GCM).
# Never store this key in the database or inside a backup.
# BACKUP_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# ============================================================
# EMAIL (Resend)
# ============================================================
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=LENS <noreply@lens.org.bd>
# ADMIN_EMAIL=admin@lens.org.bd

# ============================================================
# API KEYS
# ============================================================
# API_SECRET_KEY=your-secret-key

# ============================================================
# ACADEMIC SERVICES
# ============================================================
# ORCID API (optional - for author lookup; works without token but with rate limits)
# ORCID_ACCESS_TOKEN=your-orcid-access-token

# CrossRef API (optional - polite pool for faster requests)
# CROSSREF_POLITE_EMAIL=your-email@lensbd.org

# ============================================================
# ERROR MONITORING (Sentry)
# ============================================================
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project

# ============================================================
# SCHEDULED BACKUPS (GitHub Actions repository secrets — NOT app env)
# ============================================================
# The .github/workflows/backup.yml workflow reads these from GitHub repo
# secrets (Settings → Secrets → Actions); they are never Vercel env vars:
#   DIRECT_URL            (same direct connection as above; used by pg_dump)
#   R2_BACKUP_ACCOUNT_ID / R2_BACKUP_ACCESS_KEY_ID / R2_BACKUP_SECRET_ACCESS_KEY / R2_BACKUP_BUCKET
#   BACKUP_ENCRYPTION_KEY
