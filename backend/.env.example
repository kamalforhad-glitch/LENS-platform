# Backend configuration template. Copy to backend/.env for local development.
# Never commit populated .env files.

# Required for database-backed routes (focus, future API routes).
# Not required for /api/v1/health liveness checks.
DATABASE_URL=
DIRECT_URL=

# Required in production: exact Vercel frontend origin, comma-separated if more
# than one is genuinely needed. No wildcard and no localhost in production.
# CORS_ORIGIN=https://your-vercel-frontend.example

# Optional. Defaults shown below.
PORT=3001
NODE_ENV=development
# In non-production, CORS_ORIGIN defaults to:
# http://localhost:3000,http://127.0.0.1:3000
